# Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Firebase Configuration
# Option 1: Put your serviceAccountKey.json inside Backend/config/serviceAccountKey.json
# Option 2: Set your Firebase project ID (works with gcloud auth or Firebase CLI)
FIREBASE_PROJECT_ID=ceylon-cinnamon-pure-gold

# Option 3: Base64 or stringified JSON of your service account key
# FIREBASE_SERVICE_ACCOUNT={"type":"service_account",...}

# If using Firestore Emulator locally:
# FIRESTORE_EMULATOR_HOST=localhost:8080

# JWT Configuration
JWT_SECRET=pure_gold_cinnamon_jwt_secret_key_2025_ceylon_secure
JWT_EXPIRES_IN=7d
JWT_ADMIN_SECRET=pure_gold_cinnamon_admin_jwt_secret_key_2025_secure
JWT_ADMIN_EXPIRES_IN=12h
